import numpy as np
from funciones import *

class Usuario:
    """
    Atributos Publicos
    """
    nombre = str()
    contra = str()
    documento = str()
    correo = str()
    dia_n = int()
    mes_n = int()
    year_n = int()
    nickname = str()#Apodo unico para cada jugador
    puntaje = int()
    name_E = str()#Nombre del equipo al que pertenece
    name_T = np.ndarray#Arreglo de Torneos en los que participa
