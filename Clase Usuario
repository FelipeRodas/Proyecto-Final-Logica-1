    rol = int()

    def __init__(self,rol,nickname = "",documento = "0",contra = ""):
        """
        METODO CONSTRUCTOR
        
        Parametro obligatorio: 
        -Un entero que sera el rol del Usuario.
        1.Administrador, 2.Organizador, 3. Jugador
        Parametros Opcionales:
        -Tres strings que seran el nickname,el documento y la contraseña.
        Este metodo no tiene Return.
        """
        self.rol = rol
        self.nombre = ""
        self.documento = documento
        self.contra = contra
        self.correo = " "
        self.dia_n = 0
        self.mes_n = 0
        self.year_n = 0
        self.nickname = nickname
        self.puntaje = 0
        self.name_E = ""
        self.name_T = np.full((5), fill_value=None, dtype=object)
        self.cont_inscritos = 0
        
   
    def pedir_datos_jugador(self,nickname)-> None:
        """
    
        Este metodo recibe como parametro obligatorio un string, que sera 
        el nickname y su funcion es registrar los datos del jugador en sus 
        respectivos atributos.
        Este metodo no tiene Return.
        
        """
        self.nickname = nickname
        self.nombre = input("Ingrese el nombre del jugador: ")
        self.contra = input("Ingrese la clave para acceder al sistema: ")
        while True:
            self.documento = input("Ingrese el documento de identidad: ")
            if not self.documento.isdigit():
                print("---------------------------")
                print("El documento ingresado no es valido")
                print("---------------------------")
            else:
                break
        self.correo = input("Ingrese el correo del jugador: ")
