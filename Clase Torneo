import numpy as np
from funciones import*
from Usuario import Usuario
import random

class Torneo: 
    """
    Atributos publicos
    """
    nombre = str()
    juego = str()
    modalidad = str()
    descripcion = str()
    dia_i = int()
    mes_i = int()
    year_i = int()
    dia_f = int()
    mes_f = int()
    year_f = int()
    estado = int()
    partidas = np.ndarray
    
    
    def __init__(self,nombre = ""):
        """
        METODO CONSTRUCTOR 
        Este metodo recibe un parametro opcional que es el 
        nombre del torneo.
        Este metodo no tiene Return.
        """
        self.nombre = nombre
        self.juego = ""
        self.modalidad = "1"
        self.descripcion = ""
        self.dia_i = 0
        self.mes_i = 0
        self.year_i = 0
        self.dia_f = 0
        self.mes_f = 0
        self.year_f = 0
        self.estado = 0
        self.partidas = np.full((16), fill_value=None, dtype=object)
        
        
    def pedir_datos(self,nombre)-> None:
        """
        Este metodo recibe un parametro obligatorio ya verificado por
        el menu, dado que el nombre debe ser unico para cada torneo.
        Este metodo no tiene Return
        
        """
        self.estado = 0
        self.nombre = nombre
        self.juego = input("Ingrese el nombre del juego: ")
        print("---------------------------")
        aux = 0
        self.modalidad = input("Ingrese el tipo de modalidad, 1. Individual o 2.Por equipos: ")
        while( aux == 0):
            if(self.modalidad != "1" and self.modalidad != "2"):
                print("---------------------------")
                print("Ingreso una opcion no valida")
                print("---------------------------")
                self.modalidad = input("Ingrese el tipo de modalidad, 1. Individual o 2.Por equipos: ")
                print("---------------------------")
                
            else:
                aux = 1
                
        print("---------------------------")
        self.descripcion = input("Ingrese una descripcion breve del Torneo: ")
        print("---------------------------")
        print("Fecha de incio del Torneo")
        while True:
            dia_i = int(input("Día de inicio: "))
            mes_i = int(input("Mes de inicio: "))
            año_i = int(input("Año de inicio: "))
            print("---------------------------")
        
            r = Verificar_Inicio(dia_i, mes_i, año_i)
        
            match r:
                case 0:
                    print("Fecha de inicio válida.")
                    break
                case 1:
                    print("Error: el año es anterior al actual.")
                case 2:
                    print("Error: el mes no es válido.")
                case 3:
                    print("Error: el día no es válido o no existe.")
                case 4:
                    print("Error: la fecha es anterior a hoy.")
            print("Intente de nuevo.\n")
            print("---------------------------")
        
        print("Fecha de Finalizacion de Torneo")
        print("---------------------------")
        while True:
            dia_f = int(input("Día de finalización: "))
            mes_f = int(input("Mes de finalización: "))
            año_f = int(input("Año de finalización: "))
            print("---------------------------")
            
            r = Verificar_Final(dia_i, mes_i, año_i, dia_f, mes_f, año_f)
            
            match r:
                case 0:
                    print("Fecha de finalización válida.")
                    break
                case 1:
                    print("Error: año inválido o anterior a hoy.")
                case 2:
                    print("Error: mes inválido.")
                case 3:
                    print("Error: día inválido.")
                case 4:
                    print("Error: la fecha de finalización es anterior a la de inicio.")
            print("Intente de nuevo.\n")
            print("---------------------------")
            
        print("Torneo creado correctamente.\n")
        
        
    def Cambiar_estado(self,arreglo_jugadores,contador)-> None:
        """
         
        Este metodo recibe como parametros obligatorios un arreglo de objetos, el cual
        tendra todos los jugadores del sistema y un entero el cual sera la cantidad de
        jugadores que hay en el sistema.
        Este metodo no tiene Return
        
        """
        arreglo = np.ndarray(contador, dtype=object)
        for i in range(contador):
            if arreglo_jugadores[i].name_T ==self.nombre:
                arreglo[i]=arreglo_jugadores[i]
        while True:
            aux = input("Ingrese el estado del torneo \n 0.Abierto \n 1.En curso\n 2.Finalizado \n 3.Cancelado: ")
            
            match aux:
                case "0":
                    self.estado = int(aux)
                    print("Se ha modificado el estado del Torneo: ABIERTO")
                    break
                case "1":
                    self.estado = int(aux)
                    print("Se ha modificado el estado del Torne: EN CURSO")
                    print("---------------------------")
                    print("Se estan llevando acabo las partidas")   
                    print("---------------------------")
                    for i in range (len(self.partidas)):
                        self.partidas[i] = "Partida"+ str(i+1)
                        print(self.partidas[i])
                     
                        for i in range(len(arreglo)):
                            if arreglo[i] is not None:
                                arreglo[i].puntaje = random.randint(0, 100)
                        
                    break
                case "2":
                    self.estado = int(aux)
                    print("Se ha modificado el estado del Torne: FINALIZADO")
                    nombre_ganador = ""
                    puntaje_max = 0
                    
                    for i in range (len(arreglo)):
                        if arreglo[i] is not None:
                            if arreglo[i].puntaje > puntaje_max:
                                puntaje_max = arreglo[i].puntaje
                                nombre_ganador = arreglo[i].nombre
                    print("EL ganador del Torneo es:",nombre_ganador,"Con un puntaje de:",puntaje_max)
                            
                    break
                case "3":
                    self.estado = int(aux)
                    print("Se ha modificado el estado del Torne: CANCELADO")
                    
                case _:
                    print("Error: Ingreso una opcion no valida." )
            print("Intente de nuevo.\n")
            
