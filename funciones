from datetime import date
import os

"""
En este archivo se guardaran y se haran las funciones auxiliares 
que serviran como soporte para los metodos de las diferentes clases
"""

"""
FUNCION LIMPIAR_CONSOLA

Esta funcion no recibe parametros y su trabajo es limpiar la consola del usuario
"""
def limpiar_consola():
    comando = 'cls' if os.name == 'nt' else 'clear'
    os.system(comando)


"""
FUNCION LEER_ENTERO

Esta funcion recibe un mensaje, pide un dato al usuario y verifica
que sea un numero entero. Si el usuario ingresa un caracter no numerico
se vuelve a pedir el dato sin que se corte la ejecucion.
"""
def leer_entero(mensaje):
    valor = input(mensaje)
    while not valor.isdigit():
        print("Se ingreso un dato no valido")
        print("---------------------------")
        valor = input(mensaje)
    return int(valor)


"""
FUNCION VERIFICAR_FECHA_I

Esta funcion recibe como parametros 3 enteros, que seran el dia, mes y año de 
inicio del torneo respectivamente y verificara que esos numeros ingresados 
sean validos el dia no puede ser menor al dia actual,o mayor la dia maximo de cada mes
"""
def Verificar_Inicio(dia, mes, año):
    diamax = 0
    hoy = date.today()
    
    # Año inválido
    if año < hoy.year or año > 9999:
        return 1
    
    # Mes inválido
    if mes < 1 or mes > 12:
        return 2
    
    # Días máximos del mes
    if (año % 4 == 0 and año % 100 != 0) or (año % 400 == 0):
        feb = 29
    else:
        feb = 28
    
    match mes:
        case 1 | 3 | 5 | 7 | 8 | 10 | 12:
            diamax = 31
        case 4 | 6 | 9 | 11:
            diamax = 30
        case 2:
            diamax = feb
    
    # Día inválido
    if dia < 1 or dia > diamax:
        return 3
    
    # Fecha anterior a hoy
    fecha_ingresada = date(año, mes, dia)
    if fecha_ingresada < hoy:
        return 4
    
    return 0


"""
FUNCION VERIFICAR_FECHA_F

Esta funcion recibe como parametros 6 parametros, el dia, mes y año correspondieste
a la fecha de inicio y el dia,mes y año  de finalizacion para verificar que la fecha de 
finalizacion sea una fecha valida y que la fecha de finalizacion no sea menor a la 
fecha de inicio
"""
def Verificar_Final(dia_i, mes_i, año_i, dia, mes, año):
    diamax = 0
    hoy = date.today()
    
    # Validar mes
    if mes < 1 or mes > 12:
        return 2
    
    # Determinar días máximos del mes
    if (año % 4 == 0 and año % 100 != 0) or (año % 400 == 0):
        feb = 29
    else:
        feb = 28
    
    match mes:
        case 1 | 3 | 5 | 7 | 8 | 10 | 12:
            diamax = 31
        case 4 | 6 | 9 | 11:
            diamax = 30
        case 2:
            diamax = feb
    
    # Validar día
    if dia < 1 or dia > diamax:
        return 3
    
    # Validar año
    if año < hoy.year or año > 9999:
        return 1
    
    # Crear fechas completas
    fecha_i = date(año_i, mes_i, dia_i)
    fecha_f = date(año, mes, dia)
    
    # Comparar con la fecha actual
    if fecha_f < hoy:
        return 1  # fecha final no puede ser anterior a hoy
    
    # Comparar fechas de inicio y fin
    if fecha_f < fecha_i:
        return 4  # fecha final menor que la inicial
    
    return 0


"""
FUNCION VERIFICAR_OPCION

Esta funcion recibe 1 parametro de tipo string que es la opcion 
de un menu de 3 opciones validas para verificar que al ingresar la opcion,
se ingrese una opcion valida
"""
def Verificacion_Opcion(opc):
    while (opc != "1" and opc != "2" and opc != "3" and opc != "0" and opc != "4"):
        print("Se ingreso una opcion no valida")
        print("---------------------------")
        opc = input("Ingrese una opcion valida: ")
    return opc


"""
FUNCION VERIFICAR_NACIMIENTO

Esta funcion recibe 3 parametros dia, mes y año que son la fecha de 
nacimento del usuario y lo que hace es verificar que dicha fecha sea valida
"""       
def Verificar_nacimiento(dia, mes, año):
    diamax = 0
    hoy = date.today()
    
    # Año inválido
    if año > hoy.year:
        return 1
    
    # Mes inválido
    if mes < 1 or mes > 12:
        return 2
    
    # Días máximos del mes
    if (año % 4 == 0 and año % 100 != 0) or (año % 400 == 0):
        feb = 29
    else:
        feb = 28
    
    match mes:
        case 1 | 3 | 5 | 7 | 8 | 10 | 12:
            diamax = 31
        case 4 | 6 | 9 | 11:
            diamax = 30
        case 2:
            diamax = feb
    
    # Día inválido
    if dia < 1 or dia > diamax:
        return 3
    
    # Fecha futura inválida
    fecha_ingresada = date(año, mes, dia)
    if fecha_ingresada > hoy:
        return 4
    
    return 0
    
