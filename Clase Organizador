class Organizador:
    """
    Clase Organizador:
	permite manejar la creación y configuración de torneos
    """

    def __init__(self, usuario, contraseña):
        self.usuario = usuario
        self.contraseña = contraseña

    def verificacion(self, lista_organizadores):
        for org in lista_organizadores:
            if self.usuario == org.usuario and self.contraseña == org.contraseña:
                print("Bienvenido al sistema de organizadores")
                return True
        print("Usuario o contraseña incorrecta")
        return False

    def configuracion_torneo(self):

        torneo.crear_torneo()
        torneo.Cambiar_estado()

    def resultados_partida(self):
        print("Se registraron los resultados de la partida")

    def mostrar_resultados(self, lista_jugadores):

        n = len(lista_jugadores)
        for i in range(n - 1):
            for j in range(n - 1 - i):
                if lista_jugadores[j].puntuacion > lista_jugadores[j + 1].puntuacion:
                    lista_jugadores[j], lista_jugadores[j + 1] = lista_jugadores[j + 1], lista_jugadores[j]

        print("Resultados del torneo:")
        for j in lista_jugadores:
            print(f"{j.nombre} tiene {j.puntuacion} puntos")

        return lista_jugadores



