    def crear_torneo(self):
        if self.n_torneos == 0:
            Torneo1 = Torneo()
            nombre = input("Ingrese el nombre del torneo: ")
            Torneo1.pedir_datos(nombre)
            self.torneos[self.n_torneos] = Torneo1
            self.n_torneos += 1

        else:
            while True:
                Torneo1 = Torneo()
                nombre = input("Ingrese el nombre del torneo: ")
                flag = False

                # Recorre solo los torneos ya creados
                for j in range(self.n_torneos):
                    if self.torneos[j].nombre == nombre:
                        flag = True
                        break

                if flag:
                    print("---------------------------")
                    print("El nombre ingresado ya está registrado en otro torneo")
                    print("---------------------------")
                else:
                    break

            Torneo1.pedir_datos(nombre)
            self.torneos[self.n_torneos] = Torneo1
            self.n_torneos += 1
            
    def eliminar_torneo(self):
        nombre = input("Ingrese el nombre del torneo que desea eliminar: ")
        flag = False
        pos = -1
        
        # Buscar el torneo por nombre
        for j in range(self.n_torneos):
            if self.torneos[j].nombre == nombre:
                flag = True
                pos = j
                break
        
        if not flag:
            print("---------------------------")
            print("No existe un torneo con ese nombre")
            print("---------------------------")
        else:
            # Desplazar los torneos siguientes una posición hacia la izquierda
            for k in range(pos, self.n_torneos - 1):
                self.torneos[k] = self.torneos[k + 1]
        
            # Vaciar la última posición, porque la ultima posicion se duplica
            self.torneos[self.n_torneos - 1] = None 
        
            # Actualizar contador
            self.n_torneos -= 1
            print("Torneo eliminado correctamente")
            print("---------------------------")
    
