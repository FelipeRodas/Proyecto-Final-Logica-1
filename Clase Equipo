import numpy as np
from Usuario import Usuario

class Equipo:
    """
    Atributos publicos
    """
    coordinador = Usuario
    nombre = str()
    puntaje = int()
    jugadores = np.ndarray

    """
    METODO CONSTRUCTOR
    este metodo no recibe parametros para crear un equipo
    """
    def __init__(self):
        self.nombre = ""
        self.coordinador = None
        self.jugadores = np.full((5), fill_value=None, dtype=object)
        self.puntaje = 0

    """
    METODO CREAR_EQUIPO
    este metodo se usa para crear un equipo, la verificacion de que el nombre
    sea unico se realiza desde la app
    """
    def crear_equipo(self) -> None:
        print("Creación de equipo.")
        self.nombre = input("Ingrese el nombre del equipo: ")
        print("El equipo", self.nombre, "ha sido creado.")
        print("---------------------------")

    """
    METODO AGREGAR_JUGADOR
    Permite agregar un jugador al equipo. Recibe el objeto Usuario del jugador
    y la cantidad actual de jugadores en el equipo y retorna la nueva cantidad.
    """
    def agregar_jugador(self, jugador, cont) -> int:
        print("Agregar un jugador al equipo.")
        if cont >= 5:
            print("El equipo ya cuenta con 5 jugadores.")
            print("---------------------------")
            return cont

        # Verificar que no esté repetido
        i = 0
        while i < cont:
            if self.jugadores[i] == jugador:
                print("Este jugador ya está en el equipo.")
                print("---------------------------")
                return cont
            i += 1

        self.jugadores[cont] = jugador
        cont += 1

        if self.coordinador is None:
            self.coordinador = jugador

        print("Jugador agregado al equipo.")
        print("---------------------------")
        return cont

    """
    METODO ELIMINAR_JUGADOR
    elimina un jugador, si es el coordinador lo deja vacio o asigna otro.
    """
    def eliminar_jugador(self, jugador, cont) -> int:
        print("Eliminar un jugador del equipo.")
        pos = -1
        i = 0
        while i < cont:
            if self.jugadores[i] == jugador:
                pos = i
                break
            i += 1

        if pos == -1:
            print("Dato no encontrado.")
            print("---------------------------")
            return cont

        j = pos
        while j < cont - 1:
            self.jugadores[j] = self.jugadores[j + 1]
            j += 1

        self.jugadores[cont - 1] = None
        cont -= 1

        if self.coordinador == jugador:
            if cont > 0:
                self.coordinador = self.jugadores[0]
            else:
                self.coordinador = None

        print("Jugador eliminado.")
        print("---------------------------")
        return cont
