class Jugador:
    """
    Atributos publicos
    """
    nombre = str()
    documento = str()
    correo = str()
    dia_n = int()
    mes_n = int()
    year_n = int()
    nickname = str()#Apodo unico para cada jugador
    puntaje = float()
    name_T = str()#Nombre del torneo al que pertenece
    
    
    """
    METODO CONSTRUCTOR
    Este metodo no recibe parametros para crear un Jugador
    """
    def __init__(self):
        self.nombre = " "
        self.documento =  " "
        self.correo = " "
        self.dia_n = 0
        self.mes_n = 0
        self.year_n = 0
        self.nickname = " "
        self.puntaje = 0.0
        self.name_T = " "
        
    """
    METODO CREAR_JUGADOR
    Este metodo recibe como parametro el nickname y su funcion es 
    registrar los datos del jugador en sus respectivos atributos
    """
    def pedir_datos(self,nickname)-> None:
        self.nickname = nickname
        self.nombre = input("Ingrese el nombre del jugador: ")
        self.documento = input("Ingrese el documento de identidad: ")
        self.correo = input("Ingrese el correo del jugador: ")
        while True:
            dia_i = int(input("Ingrese el dia de nacimiento: "))
            mes_i = int(input("Ingrese el mes de nacimiento: "))
            año_i = int(input("Ingrese el año de nacimiento: "))
            print("---------------------------")
            r = Verificar_nacimiento(dia_i, mes_i, año_i)
            match r:
                case 0:
                    print("Fecha de nacimiento válida.")
                    break
                case 1:
                    print("Error: el año es posterior al actual.")
                case 2:
                    print("Error: el mes no es válido.")
                case 3:
                    print("Error: el día no es válido o no existe.")
                case 4:
                    print("Error: la fecha es posterior a hoy.")
            print("Intente de nuevo.\n")
            print("---------------------------")
            
        self.name_T = input("Ingrese el nombre del Torneo donde quiere participar: ")
